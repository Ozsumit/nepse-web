]:bg-neutral-950/60\"><div class=\"mx-auto flex h-16 max-w-7xl items-center justify-between px-4\"><div class=\"flex items-center gap-8\"><a class=\"flex items-center space-x-2\" href=\"/dashboard\"><svg class=\"h-8 w-8 text-primary-600\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 3v18h18\"></path><path d=\"m19 9-5 5-4-4-3 3\"></path></svg><span class=\"text-xl font-bold text-gray-900 dark:text-white\">NEPSE Tracker</span></a></div><div class=\"flex items-center gap-4\"><div class=\"flex items-center gap-2\"><a href=\"/login\"><button class=\"inline-flex items-center justify-center font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 bg-transparent hover:bg-gray-100 dark:hover:bg-neutral-800 h-8 px-3 text-xs rounded-md\">Sign In</button></a><a href=\"/signup\"><button class=\"inline-flex items-center justify-center font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 disabled:pointer-events-none disabled:opacity-50 bg-primary-600 text-white hover:bg-primary-700 focus-visible:ring-primary-500 h-8 px-3 text-xs rounded-md\">Get Started</button></a></div></div></div></header><div class=\"w-full bg-[#0D1322] border-b border-slate-800/80 py-2.5 overflow-hidden\"><div class=\"max-w-7xl mx-auto px-4 flex items-center gap-6 overflow-x-auto no-scrollbar whitespace-nowrap text-xs\"><span class=\"flex items-center gap-1.5 font-bold uppercase tracking-wider text-emerald-400\"><span class=\"h-2 w-2 rounded-full bg-emerald-400 animate-ping\"></span>Live Market</span><div class=\"h-3.5 w-px bg-slate-800\"></div><div class=\"flex gap-8 items-center\"><div class=\"flex items-center gap-2 font-mono\"><span class=\"font-semibold text-slate-200\">NABIL</span><span class=\"text-slate-400\">Rs. <!-- -->585.0</span><span class=\"text-emerald-400\">+2.4%</span></div><div class=\"flex items-center gap-2 font-mono\"><span class=\"font-semibold text-slate-200\">SHIVM</span><span class=\"text-slate-400\">Rs. <!-- -->492.1</span><span class=\"text-rose-400\">-1.1%</span></div><div class=\"flex items-center gap-2 font-mono\"><span class=\"font-semibold text-slate-200\">HDL</span><span class=\"text-slate-400\">Rs. <!-- -->1420.0</span><span class=\"text-emerald-400\">+0.8%</span></div><div class=\"flex items-center gap-2 font-mono\"><span class=\"font-semibold text-slate-200\">CIT</span><span class=\"text-slate-400\">Rs. <!-- -->2180.0</span><span class=\"text-emerald-400\">+3.2%</span></div><div class=\"flex items-center gap-2 font-mono\"><span class=\"font-semibold text-slate-200\">GBIME</span><span class=\"text-slate-400\">Rs. <!-- -->212.5</span><span class=\"text-rose-400\">-0.5%</span></div><div class=\"flex items-center gap-2 font-mono\"><span class=\"font-semibold text-slate-200\">NICA</span><span class=\"text-slate-400\">Rs. <!-- -->418.0</span><span class=\"text-emerald-400\">+1.9%</span></div></div></div></div><main class=\"flex-1\"><section class=\"relative pt-20 pb-16 md:pt-28 md:pb-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gradient-to-tr from-emerald-500/20 to-cyan-500/20 blur-[130px] -z-10 pointer-events-none rounded-full\"></div><div class=\"text-center max-w-3xl mx-auto space-y-6\"><div class=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-medium backdrop-blur-md\"><span class=\"h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse\"></span>Automated NEPSE Target Engine v2.0</div><h1 class=\"text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.1]\">Never miss a NEPSE swing again.</h1><p class=\"text-base sm:text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed\">Set automated target buy/sell trigger points. Get instant latency-free alerts directly via SMS, Email, and Telegram bot.</p><div class=\"pt-2 flex flex-col sm:flex-row items-center justify-center gap-4\"><a class=\"w-full sm:w-auto\" href=\"/signup\"><button class=\"inline-flex items-center justify-center transition-colors focus-visible:outline-none focus-visible:ring-2 disabled:pointer-events-none disabled:opacity-50 focus-visible:ring-primary-500 text-base rounded-lg w-full sm:w-auto px-8 bg-emerald-500 hover:bg-emerald-400 text-black font-bold h-12 shadow-lg shadow-emerald-500/25 border-0\">Sign Up &amp; Authenticate</button></a><a class=\"w-full sm:w-auto\" href=\"/dashboard\"><button class=\"inline-flex items-center justify-center font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border dark:border-neutral-700 dark:hover:bg-neutral-800 text-base rounded-lg w-full sm:w-auto px-8 bg-slate-900/60 border-slate-700 hover:bg-slate-800 text-slate-200 h-12\">Login to Dashboard</button></a></div></div></section><section id=\"authenticate\" class=\"max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10\"><div class=\"relative rounded-3xl p-1 bg-gradient-to-b from-emerald-500/40 via-slate-800/40 to-slate-900/80 shadow-2xl\"><div class=\"bg-[#0B101B] rounded-[22px] p-6 sm:p-10 backdrop-blur-xl\"><div class=\"grid lg:grid-cols-12 gap-8 items-center\"><div class=\"lg:col-span-7 space-y-6\"><div class=\"flex items-center gap-2\"><span class=\"px-3 py-1 text-[11px] font-bold uppercase tracking-wider rounded-md bg-emerald-500/20 text-emerald-400 border border-emerald-500/30\">Step 1 • Authentication</span><span class=\"text-xs text-slate-400\">One-time validation</span></div><h2 class=\"text-2xl sm:text-4xl font-black tracking-tight text-white\">Unlock Live Execution Alerts for<!-- --> <span class=\"text-emerald-400\">Rs. 35</span> monthly</h2><p class=\"text-slate-400 text-sm sm:text-base leading-relaxed\">We charge a nominal verification fee of<!-- --> <strong>Rs. 35</strong> to filter spam bots and allocate dedicated live-market monitoring compute threads for your watchlist.</p><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2\"><div class=\"flex items-center gap-2 text-xs font-medium text-slate-300\"><div class=\"h-4 w-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-[10px] font-bold\">✓</div>Sub-second target execution</div><div class=\"flex items-center gap-2 text-xs font-medium text-slate-300\"><div class=\"h-4 w-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-[10px] font-bold\">✓</div>SMS + Telegram real-time push</div><div class=\"flex items-center gap-2 text-xs font-medium text-slate-300\"><div class=\"h-4 w-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-[10px] font-bold\">✓</div>Auto-synced portfolio targets</div><div class=\"flex items-center gap-2 text-xs font-medium text-slate-300\"><div class=\"h-4 w-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-[10px] font-bold\">✓</div>No recurring subscriptions</div></div><div class=\"p-3.5 bg-slate-900/90 rounded-xl border border-slate-800 flex items-center justify-between text-xs\"><span class=\"text-slate-400\">Merchant UPI / Fonepay ID:</span><button class=\"font-mono text-emerald-400 hover:text-emerald-300 font-semibold flex items-center gap-1.5\">nepsealerts@fonepay<span class=\"text-[10px] bg-slate-800 px-1.5 py-0.5 rounded border border-slate-700\">Copy</span></button></div></div><div class=\"lg:col-span-5 bg-gradient-to-b from-[#121A2D] to-[#0E1424] p-6 rounded-2xl border border-slate-700/60 shadow-xl flex flex-col items-center text-center\"><div class=\"relative p-3.5 bg-white rounded-2xl shadow-inner mb-4\"><img src=\"/qr.png\" alt=\"Pay Rs. 35 QR\" class=\"w-36 h-36 sm:w-40 sm:h-40 rounded-lg\"/><div class=\"absolute -bottom-2.5 left-1/2 object-cover -translate-x-1/2 bg-slate-950 text-white font-mono text-[10px] font-bold px-3 py-0.5 rounded-full border border-slate-800 shadow\">Rs. 35 NPR</div></div><p class=\"text-[11px] text-slate-400 mb-4 mt-1\">Scan via <strong>eSewa, Khalti, IME Pay,</strong> or any<!-- --> <strong>Banking App</strong></p><form class=\"w-full space-y-2.5\"><input type=\"text\" placeholder=\"Enter Transaction ID / Reference\" required=\"\" class=\"w-full text-xs px-3.5 py-3 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-colors\" value=\"\"/><button class=\"inline-flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 disabled:pointer-events-none disabled:opacity-50 focus-visible:ring-primary-500 h-10 px-4 w-full bg-emerald-500 hover:bg-emerald-400 text-black font-bold text-xs py-3 rounded-xl transition-all\" disabled=\"\" type=\"submit\">Submit &amp; Authenticate (Rs. 35)</button></form></div></div></div></div></section><section class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20\"><div class=\"text-center max-w-2xl mx-auto mb-14\"><h2 class=\"text-2xl sm:text-4xl font-bold tracking-tight text-white\">Engineered for NEPSE Day Traders &amp; Investors</h2><p class=\"text-slate-400 text-sm mt-3\">Eliminate emotional checking. Set your price triggers and let automated workers handle the surveillance.</p></div><div class=\"grid md:grid-cols-3 gap-6\"><div class=\"p-6 rounded-2xl bg-slate-900/50 border border-slate-800 hover:border-slate-700 transition-colors\"><div class=\"h-10 w-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center font-bold mb-4\">⚡</div><h3 class=\"text-lg font-bold text-white mb-2\">Sub-Minute Polling</h3><p class=\"text-slate-400 text-xs leading-relaxed\">Our Cloudflare edge workers poll live market books and tick records continuously to catch sharp breakouts.</p></div><div class=\"p-6 rounded-2xl bg-slate-900/50 border border-slate-800 hover:border-slate-700 transition-colors\"><div class=\"h-10 w-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold mb-4\">🔔</div><h3 class=\"text-lg font-bold text-white mb-2\">Multi-Channel Alerts</h3><p class=\"text-slate-400 text-xs leading-relaxed\">Receive notifications through your preferred channel: Telegram bot triggers, high-priority SMS, or direct email.</p></div><div class=\"p-6 rounded-2xl bg-slate-900/50 border border-slate-800 hover:border-slate-700 transition-colors\"><div class=\"h-10 w-10 rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center font-bold mb-4\">📊</div><h3 class=\"text-lg font-bold text-white mb-2\">Automated Target Rebalancing</h3><p class=\"text-slate-400 text-xs leading-relaxed\">Easily modify your targets, track trailing stop-losses, and visualize target progress against real-time LTP.</p></div></div></section></main><footer class=\"border-t border-slate-800/80 bg-[#070A12] py-8 text-center text-xs text-slate-500\"><div class=\"max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4\"><p>© <!-- -->2026<!-- --> NEPSE Alerts. High frequency stock monitoring.</p><div class=\"flex gap-6 text-slate-400\"><a class=\"hover:text-white\" href=\"#\">Privacy</a><a class=\"hover:text-white\" href=\"#\">Terms</a><a class=\"hover:text-white\" href=\"#authenticate\">Support</a></div></div></footer></div><!--$--><!--/$--><script src=\"/_next/static/chunks/webpack-2eb758dea75faf50.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[1761,[\\\"177\\\",\\\"static/chunks/app/layout-af34cbad44f5b2b9.js\\\"],\\\"Providers\\\"]\\n3:I[9766,[],\\\"\\\"]\\n4:I[8924,[],\\\"\\\"]\\n5:I[1959,[],\\\"ClientPageRoot\\\"]\\n6:I[9547,[\\\"909\\\",\\\"static/chunks/909-fb024470c8a3af3d.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",